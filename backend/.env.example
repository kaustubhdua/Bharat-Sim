BHARATSIM_ENV=development
BHARATSIM_DATA_DIR=./data
BHARATSIM_MAX_UPLOAD_MB=150
BHARATSIM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Supabase/PostgreSQL connection string for the SERVER ONLY.
# When unset, local development uses SQLite. Never put this in VITE_* variables.
# Vercel/IPv4 serverless should use the Supabase Transaction Pooler URI (port 6543).
# Copy the exact host, username and password from Project Settings -> Database -> Connection string.
# BHARATSIM_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
#
# Direct connections may require IPv6 and are not the recommended Vercel configuration.
# BHARATSIM_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Configure a random secret (32+ characters) on BOTH the API and isolated worker.
# Worker dispatch endpoints are enabled only when this token is configured.
# Never expose this secret in VITE_* frontend variables.
# BHARATSIM_WORKER_TOKEN=replace-with-a-long-random-secret
# SARVAM_API_KEY=

# Optional shared-key gate for a private single-tenant deployment.
# If enabled in production, BHARATSIM_API_KEY must be at least 32 characters.
# This shared-key gate is NOT per-user authentication.
BHARATSIM_REQUIRE_API_KEY=false
# BHARATSIM_API_KEY=replace-with-a-long-random-secret

# Supabase Auth user identity (enable asymmetric JWT signing keys in Supabase Auth).
# BHARATSIM_AUTH_REQUIRED=true
# SUPABASE_URL=https://hkyieaovolkethovyenb.supabase.co

# Private Supabase Storage for APKs. Server-side only; never expose this key in VITE_*.
# Prefer the modern Supabase secret API key (sb_secret_...) for server-side Storage.
# It is sent in the apikey header only; never expose it to the browser.
# SUPABASE_SECRET_KEY=replace-with-server-only-secret
# Legacy service_role JWT remains supported as a compatibility fallback.
# SUPABASE_SERVICE_ROLE_KEY=replace-with-legacy-service-role-jwt
BHARATSIM_STORAGE_BUCKET=bharatsim-private
