{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bharat-sim-bay.vercel.app/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://bharat-sim-bay.vercel.app/health/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://bharat-sim-bay.vercel.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://bharat-sim-bay.vercel.app/openapi.json"
    },
    {
      "source": "/redoc",
      "destination": "https://bharat-sim-bay.vercel.app/redoc"
    }
  ]
}
