BHARATSIM_ENV=development
BHARATSIM_DATA_DIR=./data
BHARATSIM_MAX_UPLOAD_MB=150
BHARATSIM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Supabase/PostgreSQL direct connection string for the SERVER ONLY.
# When unset, local development uses SQLite. Never put this in VITE_* variables.
# Configure the database password and SSL settings from Supabase Connect; do not commit secrets.
# Direct connection may require IPv6; use Supabase's session pooler URL on IPv4-only hosts.
# BHARATSIM_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.hkyieaovolkethovyenb.supabase.co:5432/postgres?sslmode=require

# Configure a random secret (32+ characters) on BOTH the API and isolated worker.
# Worker dispatch endpoints are enabled only when this token is configured.
# Never expose this secret in VITE_* frontend variables.
# BHARATSIM_WORKER_TOKEN=replace-with-a-long-random-secret
# SARVAM_API_KEY=

# Optional shared-key gate for a private single-tenant deployment.
# For BHARATSIM_ENV=production, startup fails unless this is true and the key is 32+ chars.
# This shared-key gate is NOT per-user authentication.
BHARATSIM_REQUIRE_API_KEY=false
# BHARATSIM_API_KEY=replace-with-a-long-random-secret
